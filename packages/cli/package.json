{
  "name": "cms-lab",
  "version": "1.0.0",
  "type": "module",
  "description": "Catch CMS bugs before deploy.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/i-afaqrashid/cms-lab.git",
    "directory": "packages/cli"
  },
  "homepage": "https://cms-lab.dev",
  "bugs": {
    "url": "https://github.com/i-afaqrashid/cms-lab/issues"
  },
  "keywords": [
    "cms",
    "nextjs",
    "prismic",
    "strapi",
    "directus",
    "wordpress",
    "cli",
    "testing"
  ],
  "bin": {
    "cms-lab": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/bin.ts --format esm --dts --clean --tsconfig ../../tsconfig.base.json"
  },
  "dependencies": {
    "@cms-lab/core": "workspace:*",
    "@cms-lab/directus": "workspace:*",
    "@cms-lab/next": "workspace:*",
    "@cms-lab/prismic": "workspace:*",
    "@cms-lab/reporter": "workspace:*",
    "@cms-lab/strapi": "workspace:*",
    "@cms-lab/wordpress": "workspace:*",
    "commander": "^14.0.2",
    "picocolors": "^1.1.1"
  },
  "author": "Afaq Rashid"
}
