{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "types": ["node", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@cms-lab/core": ["packages/core/src/index.ts"],
      "@cms-lab/contentful": ["packages/contentful/src/index.ts"],
      "@cms-lab/directus": ["packages/directus/src/index.ts"],
      "@cms-lab/next": ["packages/next/src/index.ts"],
      "@cms-lab/payload": ["packages/payload/src/index.ts"],
      "@cms-lab/prismic": ["packages/prismic/src/index.ts"],
      "@cms-lab/reporter": ["packages/reporter/src/index.ts"],
      "@cms-lab/sanity": ["packages/sanity/src/index.ts"],
      "@cms-lab/strapi": ["packages/strapi/src/index.ts"],
      "@cms-lab/wordpress": ["packages/wordpress/src/index.ts"],
      "@cms-lab/cli": ["packages/cli/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "benchmarks/**/*.ts", "vitest.config.ts"]
}
